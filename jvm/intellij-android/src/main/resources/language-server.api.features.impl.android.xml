<idea-plugin visibility="internal">
  <dependencies>
    <plugin id="org.jetbrains.android" />
    <module name="intellij.platform.core" />
    <module name="intellij.platform.core.impl" />
    <module name="intellij.platform.analysis" />
    <module name="intellij.platform.lang" />
    <module name="intellij.platform.editor.ex" />
    <module name="intellij.platform.editor.ui" />
    <module name="intellij.platform.debugger" />
    <module name="intellij.platform.debugger.impl" />
    <module name="intellij.java.psi" />
    <module name="intellij.java.psi.impl" />
    <module name="intellij.java.debugger" />
    <module name="intellij.java.debugger.impl" />
    <module name="intellij.xml.parser" />
    <module name="intellij.xml.psi" />
    <module name="intellij.xml.psi.impl" />
    <module name="intellij.libraries.asm" />
    <module name="intellij.libraries.asm.tools" />
    <module name="intellij.libraries.guava" />
    <module name="language-server.analyzer" />
    <module name="language-server.api.features" />
  </dependencies>

  <projectListeners>
    <listener class="org.jetbrains.android.debug.AndroidDebuggerListener"
              topic="com.intellij.debugger.impl.DebuggerManagerListener" />
    <listener class="org.jetbrains.android.debug.AndroidDebuggerListener"
              topic="com.intellij.xdebugger.XDebuggerManagerListener" />
  </projectListeners>

  <extensions defaultExtensionNs="com.intellij">
    <lang.directNavigationProvider implementation="org.jetbrains.android.navigation.AndroidResourceNavigation" />
    <lang.inspectionSuppressor language="kotlin" implementationClass="org.jetbrains.android.compose.ComposeSuppressor" />
    <debugger.fieldVisibilityProvider implementation="org.jetbrains.android.debug.AndroidFieldVisibilityProvider" />
  </extensions>
</idea-plugin>
