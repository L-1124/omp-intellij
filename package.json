{
  "name": "omp-intellij",
  "version": "2026.1107.0",
  "description": "IntelliJ language intelligence, JVM execution and debugging, with Android JDWP attach for OMP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "src/",
    "jvm/intellij-android/src/",
    "jvm/intellij-android/gradle/",
    "jvm/intellij-android/gradlew",
    "jvm/intellij-android/gradlew.bat",
    "jvm/intellij-android/build.gradle.kts",
    "jvm/intellij-android/settings.gradle.kts",
    "jvm/intellij-android/gradle.properties",
    "jvm/intellij-android/gradle.lockfile",
    "resources/ils/",
    "scripts/setup-dev-env.mjs",
    "scripts/run-gradle.mjs",
    "scripts/clean-runtime.mjs",
    "settings.json",
    ".omp-plugin/marketplace.json",
    "docs/",
    "README.md"
  ],
  "bin": {
    "omp-intellij-lsp": "./dist/bridge.js",
    "omp-intellij-dap": "./dist/debug/dap-proxy.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "prepack": "npm run build",
    "build:jvm": "node scripts/run-gradle.mjs stageExtension --no-daemon",
    "test:jvm": "node scripts/run-gradle.mjs test --no-daemon",
    "clean:runtime": "node scripts/clean-runtime.mjs",
    "watch": "tsc -w",
    "pretest": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && npm run build && tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=30000 \"dist-test/test/*.test.js\" \"test/*.test.mjs\"",
    "update-bundle": "npm run build && node scripts/update-server-bundle.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:android": "node scripts/test-integration.mjs android",
    "test:integration:xml": "node scripts/test-integration.mjs xml",
    "test:integration:engineering": "node scripts/test-integration.mjs engineering",
    "test:integration:stability": "node scripts/test-integration.mjs stability",
    "test:acceptance": "node scripts/run-gradle.mjs stageExtension test --no-daemon && npm test && npm run test:integration -- --no-prepare",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "keywords": [
    "omp",
    "intellij",
    "lsp",
    "dap",
    "jvm",
    "kotlin",
    "java"
  ],
  "author": "L-1124",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-1124/omp-intellij.git"
  },
  "homepage": "https://github.com/L-1124/omp-intellij#readme",
  "bugs": {
    "url": "https://github.com/L-1124/omp-intellij/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@oh-my-pi/omptype": "18.18.7",
    "@oh-my-pi/pi-coding-agent": "18.18.7",
    "@types/node": "^24.12.0",
    "typescript": "^7.0.2"
  },
  "omp": {
    "extensions": [
      "./src/plugin.ts"
    ]
  }
}
