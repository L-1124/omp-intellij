{
  "name": "omp-intellij",
  "version": "2026.1107.0",
  "description": "IntelliJ language intelligence, JVM execution and debugging for OMP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "src/",
    "settings.json",
    ".omp-plugin/marketplace.json",
    "README.md"
  ],
  "bin": {
    "omp-intellij-lsp": "./dist/bridge.js",
    "omp-intellij-dap": "./dist/debug/dap-proxy.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "prepack": "npm run build",
    "watch": "tsc -w",
    "pretest": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && npm run build && tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=30000 \"dist-test/test/*.test.js\" \"test/*.test.mjs\"",
    "update-bundle": "npm run build && node scripts/update-server-bundle.mjs",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "node --test --test-timeout=180000 \"dist-test/test/integration/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "keywords": [
    "omp",
    "intellij",
    "lsp",
    "dap",
    "jvm",
    "kotlin",
    "java"
  ],
  "author": "L-1124",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-1124/omp-intellij.git"
  },
  "homepage": "https://github.com/L-1124/omp-intellij#readme",
  "bugs": {
    "url": "https://github.com/L-1124/omp-intellij/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.12.0",
    "typescript": "^7.0.2"
  },
  "omp": {
    "extensions": [
      "./src/plugin.ts"
    ]
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}
